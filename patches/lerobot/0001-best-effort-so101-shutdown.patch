+
+from collections.abc import Callable, Iterable
+
+
+def run_cleanup(actions: Iterable[tuple[str, Callable[[], None]]]) -> None:
+    """Attempt every cleanup action, then report every failure.
+
+    Cleanup can release motor torque: a failed action must remain visible, but
+    must not prevent later motors, ports or camera threads from being released.
+    """
+    errors: list[BaseException] = []
+    for name, action in actions:
+        try:
+            action()
+        except BaseException as error:
+            # Even an interrupt during cleanup must not skip remaining resources.
+            error.add_note(f"Cleanup action: {name}")
+            errors.append(error)
+    if errors:
+        raise BaseExceptionGroup("One or more cleanup actions failed", errors)
