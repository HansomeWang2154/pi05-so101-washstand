+    def disconnect(self) -> None:
+        # The composite is_connected flag is false after a partial connection or
+        # a camera failure. Clean up each owned resource independently instead.
+        actions = []
+        if self.bus.is_connected:
+            actions.append(
+                ("follower motor bus", partial(self.bus.disconnect, self.config.disable_torque_on_disconnect))
+            )
+        for name, cam in self.cameras.items():
+            if cam.is_connected or getattr(cam, "thread", None) is not None:
+                actions.append((f"follower camera: {name}", cam.disconnect))
+        run_cleanup(actions)
         logger.info(f"{self} disconnected.")


